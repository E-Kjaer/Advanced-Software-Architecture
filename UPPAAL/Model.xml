<nta>
	<declaration>// Place global declarations here.
chan overload, ready, halt, go;

int gels_in_queue = 0;
bool overloaded = false;

void increment_gels() {
    gels_in_queue++;
}

void decrement_gels() {
    gels_in_queue--;
}</declaration>
	<template>
		<name>Conveyor</name>
		<parameter>const int capacity</parameter>
		<location id="id0" x="-34" y="-93">
			<name x="-59" y="-144">Running</name>
		</location>
		<init ref="id0"/>
		<transition id="id1">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="guard" x="8" y="-170">(gels_in_queue &lt; capacity) &amp;&amp; (overloaded)</label>
			<label kind="synchronisation" x="76" y="-110">ready!</label>
			<label kind="assignment" x="-17" y="-51">overloaded = false</label>
			<nail x="68" y="-51"/>
			<nail x="68" y="-144"/>
		</transition>
		<transition id="id2">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="guard" x="-382" y="-170">(gels_in_queue &gt;= capacity) &amp;&amp; !overloaded</label>
			<label kind="synchronisation" x="-229" y="-110">overload!</label>
			<label kind="assignment" x="-212" y="-51">overloaded = true</label>
			<nail x="-144" y="-144"/>
			<nail x="-144" y="-51"/>
		</transition>
	</template>
	<template>
		<name>PCS</name>
		<location id="id3" x="-34" y="-119">
			<name x="-59" y="-153">Monitor</name>
		</location>
		<location id="id4" x="-221" y="-8">
			<name x="-246" y="8">process_overload</name>
		</location>
		<location id="id5" x="127" y="0">
			<name x="85" y="17">process_ready</name>
		</location>
		<init ref="id3"/>
		<transition id="id6">
			<source ref="id4"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="-110" y="-25">halt!</label>
			<nail x="-102" y="-25"/>
		</transition>
		<transition id="id7">
			<source ref="id3"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="8" y="-51">ready?</label>
			<nail x="0" y="-25"/>
		</transition>
		<transition id="id8">
			<source ref="id5"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="102" y="-85">go!</label>
			<nail x="93" y="-93"/>
		</transition>
		<transition id="id9">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-212" y="-119">overload?</label>
			<nail x="-170" y="-93"/>
		</transition>
	</template>
	<template>
		<name>Sealer</name>
		<parameter>const int sealer_delay</parameter>
		<declaration>clock y;</declaration>
		<location id="id10" x="0" y="-25">
		</location>
		<init ref="id10"/>
		<transition id="id11">
			<source ref="id10"/>
			<target ref="id10"/>
			<label kind="guard" x="34" y="-8">y&gt;=sealer_delay &amp;&amp; gels_in_queue &gt; 0</label>
			<label kind="assignment" x="-68" y="51">y=0,
decrement_gels()</label>
			<nail x="-51" y="42"/>
			<nail x="51" y="42"/>
		</transition>
	</template>
	<template>
		<name x="5" y="5">Tapper</name>
		<parameter>const int tapper_delay</parameter>
		<declaration>// Place local declarations here.
clock x;</declaration>
		<location id="id12" x="-8" y="85">
			<name x="34" y="68">Running</name>
		</location>
		<location id="id13" x="-212" y="85">
			<name x="-246" y="51">Halt</name>
		</location>
		<init ref="id12"/>
		<transition id="id14">
			<source ref="id13"/>
			<target ref="id12"/>
			<label kind="synchronisation" x="-144" y="102">go?</label>
			<nail x="-93" y="110"/>
		</transition>
		<transition id="id15">
			<source ref="id12"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-136" y="34">halt?</label>
			<nail x="-127" y="51"/>
		</transition>
		<transition id="id16">
			<source ref="id12"/>
			<target ref="id12"/>
			<label kind="guard" x="42" y="102">x &gt;= tapper_delay</label>
			<label kind="assignment" x="-93" y="161">x = 0,
increment_gels()</label>
			<nail x="-76" y="153"/>
			<nail x="59" y="153"/>
		</transition>
	</template>
	<system>const int tapper_delay = 5;
const int sealer_delay = 50;
const int capacity = 20;

C = Conveyor(capacity);
P = PCS();
S = Sealer(sealer_delay);
T = Tapper(tapper_delay);

// List one or more processes to be composed into a system.
system C, P, S, T;
</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
