	<system>const int tapper_delay = 5;
const int sealer_delay = 50;
const int capacity = 5;

C = Conveyor(capacity);
P = PCS();
S = Sealer(sealer_delay);
T = Tapper(tapper_delay);

// List one or more processes to be composed into a system.
system C, P, S, T;
</system>
