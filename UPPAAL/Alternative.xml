	<template>
		<name x="5" y="5">Tapper</name>
		<declaration>// Place local declarations here.
clock x;

</declaration>
		<location id="id24" x="0" y="0">
			<name x="-17" y="-42">Idle</name>
		</location>
		<location id="id25" x="153" y="0">
			<name x="119" y="-42">Producing</name>
			<label kind="invariant" x="136" y="17">x&lt;=20</label>
		</location>
