			<target ref="id9"/>
			<label kind="synchronisation" x="-187" y="-187">produced?</label>
			<label kind="assignment" x="-161" y="-221">gels++</label>
		</transition>
		<transition id="id18">
			<source ref="id10"/>
			<target ref="id8"/>
			<label kind="guard" x="-85" y="59">gels&gt;0</label>
			<nail x="-17" y="51"/>
		</transition>
		<transition id="id19">
			<source ref="id8"/>
			<target ref="id10"/>
