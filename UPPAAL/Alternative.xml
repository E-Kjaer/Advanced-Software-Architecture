			<name x="-826" y="21">Initial</name>
		</location>
		<location id="id6" x="-595" y="51">
			<name x="-620" y="68">NoGels</name>
		</location>
		<location id="id7" x="-476" y="-68">
			<name x="-486" y="-98">StartSealer</name>
