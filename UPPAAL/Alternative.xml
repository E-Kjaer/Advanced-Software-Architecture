			<target ref="id25"/>
			<label kind="synchronisation" x="51" y="-68">startTapper?</label>
			<label kind="assignment" x="25" y="-51">x=0</label>
			<nail x="76" y="-42"/>
		</transition>
	</template>
	<system>// Place template instantiations here.
t1 = Tapper();
t2 = Tapper();
t3 = Tapper();
pcs = PCS();
s = Sealer();
// List one or more processes to be composed into a system.
system pcs, t1, t2, t3, s;
</system>
	<queries>
		<option key="--diagnostic" value="0"/>
		<query>
			<formula>A[] pcs.gels &gt;= 0 &amp;&amp; pcs.gels &lt;= 20</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-11-11 14:15:46 +0100">
				<option key="--diagnostic" value="0"/>
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-11-11 14:15:46 +0100">
			</result>
		</query>
		<query>
			<formula>A[] (s.Running imply pcs.gels &gt;= 0)</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-11-11 14:15:46 +0100">
				<option key="--diagnostic" value="0"/>
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; s.Idle</formula>
