			<nail x="84" y="46"/>
		</transition>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="42" y="-76">startSealer?</label>
			<label kind="assignment" x="34" y="-51">x=0</label>
			<nail x="93" y="-51"/>
		</transition>
	</template>
	<template>
		<name>PCS</name>
