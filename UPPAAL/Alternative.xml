		</location>
		<location id="id8" x="-102" y="-102">
			<name x="-68" y="-110">HasGels</name>
		</location>
		<location id="id9" x="-102" y="-255">
			<committed/>
		</location>
		<location id="id10" x="-102" y="51">
			<committed/>
		</location>
		<location id="id11" x="-603" y="-255">
			<name x="-637" y="-297">Overload</name>
		</location>
		<location id="id12" x="-476" y="-144">
			<name x="-484" y="-127">StartTapper</name>
			<committed/>
		</location>
		<init ref="id5"/>
		<transition id="id13">
			<source ref="id12"/>
			<target ref="id8"/>
			<label kind="synchronisation" x="-374" y="-161">startTapper!</label>
		</transition>
		<transition id="id14">
			<source ref="id11"/>
			<target ref="id12"/>
			<label kind="guard" x="-646" y="-229">gels==20</label>
			<label kind="synchronisation" x="-603" y="-195">sealed?</label>
			<label kind="assignment" x="-552" y="-161">gels--</label>
		</transition>
		<transition id="id15">
			<source ref="id9"/>
			<target ref="id11"/>
			<label kind="guard" x="-272" y="-289">gels==20</label>
			<label kind="synchronisation" x="-391" y="-289">haltTapper!</label>
		</transition>
		<transition id="id16">
			<source ref="id9"/>
			<target ref="id8"/>
			<label kind="guard" x="-76" y="-289">gels&lt;20</label>
			<nail x="-25" y="-255"/>
		</transition>
		<transition id="id17">
