		</query>
		<query>
			<formula>E&lt;&gt; s.Running</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-11-11 14:15:49 +0100">
				<option key="--diagnostic" value="0"/>
			</result>
		</query>
	</queries>
</nta>
