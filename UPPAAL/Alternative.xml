<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
chan produced, haltSealer, startSealer;
broadcast chan sealed, haltTapper, startTapper;</declaration>
	<template>
		<name>Sealer</name>
		<declaration>clock x;</declaration>
		<location id="id0" x="0" y="0">
			<name x="-10" y="-34">Idle</name>
		</location>
		<location id="id1" x="178" y="0">
			<name x="152" y="-51">Running</name>
			<label kind="invariant" x="161" y="17">x&lt;=20</label>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="guard" x="195" y="-68">x&gt;=5</label>
			<label kind="synchronisation" x="255" y="-8">sealed!</label>
			<label kind="assignment" x="195" y="34">x=0</label>
			<nail x="246" y="-59"/>
			<nail x="246" y="51"/>
		</transition>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id0"/>
